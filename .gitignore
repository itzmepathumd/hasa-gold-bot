node_modules/

# A half-written temp file must never be committed.
orders.json.tmp

# ---------------------------------------------------------------------------
# Database secrets
# ---------------------------------------------------------------------------
# The Supabase connection string carries the database password. A .env holding
# it must never enter git, and so must a downloaded key or a credential dump
# from any provider, under the names they are normally given.
.env
.env.local
.env.*.local
*.pem
*service-account*.json
*serviceAccount*.json
credentials.json

# ---------------------------------------------------------------------------
# Local leftovers
# ---------------------------------------------------------------------------
# The bot no longer writes these; the patterns stay so a file copied from an
# older install is not committed by accident.
orders.json
orders.json.tmp
orders.prev.json
wallets.json
wallet_transactions.json
recharge_requests.json
*.log
