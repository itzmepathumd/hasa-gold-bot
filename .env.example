# ---------------------------------------------------------------------------
# HASA GOLD STORE - configuration reference
# ---------------------------------------------------------------------------
# This file lists every variable the bot reads and what it does. It contains
# no real values. Copy it, fill it in, and keep the filled copy out of git.
#
#   cp .env.example .env
#
# The database variables are the only required new ones: without them the
# bot cannot store an order, and it says so and stops rather than trading on
# a copy. Everything else is the same configuration as before.

# --- Hosting: long polling (default) or webhook ----------------------------
# Leave WEBHOOK_URL empty and the bot polls Telegram, which is what it has
# always done and is fine on a machine that stays awake.
#
# Set it on a platform that sleeps or stops idle services (Render, Railway,
# Fly, Koyeb). Telegram then pushes updates to that HTTPS URL instead, and the
# process wakes only when there is something to do. Use the platform's own URL.
#
# WEBHOOK_SECRET is required with it. Telegram echoes it back on every request,
# and without it anyone who learns the URL could post a forged update that
# approves an order. Any long random string; keep it identical on both sides.
WEBHOOK_URL=
WEBHOOK_SECRET=

# The port to listen on. Platforms set PORT themselves; this is only a
# fallback for running a webhook host by hand.
PORT=8080

# --- Telegram --------------------------------------------------------------
# From @BotFather. Required.
BOT_TOKEN=

# Your own Telegram user id. This is the only account allowed to approve
# orders and open the admin panel. Required. Plain digits only, no @ and no
# username: the bot prints the id it resolved on startup and refuses to start
# on a value that is not a real Telegram id, because a wrong one otherwise
# looks like a permissions problem rather than a typo.
ADMIN_ID=

# --- Supabase PostgreSQL (required) -----------------------------------------
# The connection string of the project. Supabase dashboard >
# Project settings > Database > Connection string > URI.
#
#   postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres
#
# Use the direct connection (port 5432) or the session pooler (also 5432 on
# the pooler host). The transaction pooler on port 6543 works too, because
# this project's driver sends unnamed statements.
#
# This value contains the database password. Never commit it, never print it,
# never paste it into a Telegram message, and treat a log line containing it
# as a leak. Supabase also offers a service_role key for its REST API; this
# bot does not use the REST API and does not need that key, so leave it alone.
#
# Set DATABASE_DISABLED=true to run without a database (the bot will say so
# and stop, which is what the flag is for: it exists so a local run does not
# half-start against a database it cannot reach).
SUPABASE_DB_URL=
DATABASE_DISABLED=

# How many pooled connections this process may hold. Supabase's free plan
# allows a small number per project, and the pool is shared by every query the
# bot makes. 10 is comfortable for long polling; lower it if you run several
# instances against the same project.
SUPABASE_DB_POOL_MAX=10

# TLS is on by default. Set to false only for a local PostgreSQL with no
# certificate. SUPABASE_DB_SSL_REJECT_UNAUTHORIZED=false exists only for a
# corporate proxy that re-signs TLS, and should never be the default.
SUPABASE_DB_SSL=
SUPABASE_DB_SSL_REJECT_UNAUTHORIZED=

# --- Top-up fulfilment -----------------------------------------------------
# SHOP2TOPUP_API_KEY is the credential for both jobs: checking a player ID
# before an order is accepted, and placing the top-up itself. It is
# KEY_ID.KEY_SECRET as a single string, exactly as SHOP2TOPUP issues it; a
# truncated or placeholder key authenticates as nobody and every call fails
# with an auth error rather than a player error.
#
# The variable is SHOP2TOPUP_API_BASE, not BASE_URL: it is the name
# playerValidate.js reads. The bare /catalog paths on this host answer with a
# web redirect, so the /api/endpoints/v1 prefix the bot appends is required.
SHOP2TOPUP_API_KEY=
SHOP2TOPUP_API_BASE=https://www.shop2topup.com

# While this is false the bot never places a real order. It runs the whole
# order flow and reports what it would have done, so nothing is bought by
# accident.
#
# The wallet is charged the moment an order is paid for, so this is the switch
# that decides whether real money moves. Turn it on only once a package has a
# sub_category_id and its product id has been checked against SHOP2TOPUP's own
# catalog.
SHOP2TOPUP_PRODUCTION_MODE=false

# --- EZ Cash auto verification --------------------------------------------
# Credential for the payment provider that confirms an EZ Cash deposit from
# the RN number in the payment SMS. Read on startup; a missing key disables
# the auto-verify button rather than failing the boot.
NEXAURA_API_KEY=

# --- Developer details shown on the About page ----------------------------
STORE_NAME=HASA GOLD STORE
DEVELOPER_NAME=
DEVELOPER_HANDLE=
DEVELOPER_PHONE=
DEVELOPER_WEB=
