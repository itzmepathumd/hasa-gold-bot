# ---------------------------------------------------------------------------
# HASA GOLD STORE - configuration reference
# ---------------------------------------------------------------------------
# This file lists every variable the bot reads and what it does. It contains
# no real values. Copy it, fill it in, and keep the filled copy out of git if
# it holds a real service account key.
#
#   cp .env.example .env
#
# The bot starts and runs on its JSON files when the Firebase variables are
# absent, so nothing here is required for local development.

# --- Hosting: long polling (default) or webhook ----------------------------
# Leave WEBHOOK_URL empty and the bot polls Telegram, which is what it has
# always done and is fine on a machine that stays awake.
#
# Set it on a platform that sleeps or stops idle services (Render, Railway,
# Fly, Koyeb). Telegram then pushes updates to that HTTPS URL instead, and the
# process wakes only when there is something to do. Use the platform's own URL.
#
# WEBHOOK_SECRET is required with it. Telegram echoes it back on every request,
# and without it anyone who learns the URL could post a forged update that
# approves an order. Any long random string; keep it identical on both sides.
WEBHOOK_URL=
WEBHOOK_SECRET=

# The port to listen on. Platforms set PORT themselves; this is only a
# fallback for running a webhook host by hand.
PORT=8080

# --- Telegram --------------------------------------------------------------
# From @BotFather. Required.
BOT_TOKEN=

# Your own Telegram user id. This is the only account allowed to approve
# orders and open the admin panel. Required. Plain digits only, no @ and no
# username: the bot prints the id it resolved on startup and refuses to start
# on a value that is not a real Telegram id, because a wrong one otherwise
# looks like a permissions problem rather than a typo.
ADMIN_ID=

# --- Firebase Firestore (optional) -----------------------------------------
# Set these three to move order storage to Firestore. They are the values
# from the service account JSON the Firebase console gives you, not from the
# Firebase web config. Never use a web/apiKey here: the bot runs on the
# server and uses the Admin SDK.
#
# FIREBASE_PRIVATE_KEY must keep its newlines. Hosting secret fields usually
# store it on one line as \n, which the bot converts back automatically.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Firebase, alternative: Application Default Credentials ----------------
# Leave the three variables above empty to use this instead. On Cloud Run,
# Cloud Functions, App Engine or a GCE instance, attach a service account
# and nothing needs configuring at all: no key is ever copied into your
# environment. Set GOOGLE_APPLICATION_CREDENTIALS only when running outside
# Google Cloud with a key file on disk.
GOOGLE_APPLICATION_CREDENTIALS=

# --- Store behaviour -------------------------------------------------------
# Set to false to force the JSON files even when Firebase is configured.
# Useful for comparing the two backends, and as a way back if Firestore has
# a problem.
FIRESTORE_ENABLED=true

# How to reach Firestore: grpc, rest, or auto.
#   grpc  The Firebase Admin SDK. Faster, and what a bot should normally run
#         on, but gRPC needs HTTP/2.
#   rest  The Firestore REST API. Only needs HTTPS, so it keeps the shop on
#         Firestore behind a proxy or on a host that speaks HTTP/1.1 only.
#   auto  Try gRPC and fall back to REST. The default, and it works in the
#         most places.
# Set this to rest if startup logs "gRPC unavailable".
FIRESTORE_TRANSPORT=auto

# --- Top-up fulfilment -----------------------------------------------------
# SHOP2TOPUP_API_KEY is the credential for both jobs: checking a player ID
# before an order is accepted, and placing the top-up itself. It is
# KEY_ID.KEY_SECRET as a single string, exactly as SHOP2TOPUP issues it; a
# truncated or placeholder key authenticates as nobody and every call fails
# with an auth error rather than a player error.
#
# The variable is SHOP2TOPUP_API_BASE, not BASE_URL: it is the name
# playerValidate.js reads. The bare /catalog paths on this host answer with a
# web redirect, so the /api/endpoints/v1 prefix the bot appends is required.
SHOP2TOPUP_API_KEY=
SHOP2TOPUP_API_BASE=https://www.shop2topup.com

# While this is false the bot never places a real order. It runs the whole
# order flow and reports what it would have done, so nothing is bought by
# accident.
#
# The wallet is charged the moment an order is created, so this is the switch
# that decides whether real money moves. Turn it on only once a package has a
# sub_category_id and its product id has been checked against SHOP2TOPUP's own
# catalog.
SHOP2TOPUP_PRODUCTION_MODE=false

# --- Developer details shown on the About page ----------------------------
STORE_NAME=HASA GOLD STORE
DEVELOPER_NAME=
DEVELOPER_HANDLE=
DEVELOPER_PHONE=
DEVELOPER_WEB=